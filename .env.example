# Copy this file to ".env" and edit it. The ".env" file is never committed.
#
# Claude access: pick ONE of the two options below.
#
# Option 1: an Anthropic API key (billed per use, about $1 to $1.50 per match).
#   Create one at https://console.anthropic.com/ and paste it here.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option 2: your Claude subscription, through Claude Code.
#   Install Claude Code (https://claude.com/claude-code), run `claude` once and sign in.
#   Leave ANTHROPIC_API_KEY unset. Slower, no cost counter, and the F9 screenshot read is unavailable.

# Optional settings. The defaults are shown.
# ARAMCOACH_MODEL=claude-opus-5-5
# ARAMCOACH_EFFORT=low
# ARAMCOACH_SPEED=standard          # "fast" is about 2.5x quicker for twice the price (API key only)
# ARAMCOACH_PORT=8777
# ARAMCOACH_HOST=127.0.0.1          # 0.0.0.0 to open the panel from another device on a network you trust
# ARAMCOACH_HOTKEY=F9
# ARAMCOACH_UPDATE_WHILE_ALIVE=0    # 1 also updates the plan on enemy purchases while you are alive
